{
  "manifest_version": 3,
  "name": "Radio Five Player",
  "version": "0.0.2",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "description": "Play radio stream",
  "permissions": [
    "offscreen",
    "storage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://radiofive.ru/*",
    "https://radiofive.org/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "src/settings/settings.html",
  "commands": {
    "toggle-radio": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Toggle radio play/pause"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sounds/click.mp3",
        "src/liked/liked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}